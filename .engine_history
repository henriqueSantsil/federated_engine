SELECT data_coleta AS dia, temperatura_c FROM clima WHERE temperatura_c > 30.0;
SELECT data_coleta AS dia, temperatura_c FROM clima WHERE temperatura_c > 30.5;
SELECT nome, estado FROM municipio WHERE id_municipio IN (1, 3);
SELECT nome FROM municipio WHERE nome LIKE '%Rio%';
SELECT m.nome, c.precipitacao_mm FROM clima JOIN municipio ON id_municipio = id_municipio;
SELECT id_municipio, COUNT(data_coleta) AS qtd_dias, SUM(precipitacao_mm) AS chuva_total, MAX(temperatura_c) AS temp_max FROM clima GROUP BY id_municipio ORDER BY chuva_total DESC;
SELECT nome FROM municipio WHERE id_municipio IN (SELECT id_municipio FROM safra WHERE producao_ton > 2000000);
SELECT nome, producao_ton, CASE WHEN producao_ton >= 2000000 THEN 'Gigante' ELSE 'Normal' END AS porte FROM safra JOIN municipio ON id_municipio = id_municipio;
SELECT EXTRACT(MONTH FROM data_coleta) AS mes, SUM(precipitacao_mm) AS chuva_mensal FROM clima GROUP BY mes;
WITH cidades_mt AS (SELECT id_municipio, nome FROM municipio) SELECT nome, precipitacao_mm FROM clima JOIN cidades_mt ON id_municipio = id_municipio;
